# SonarQube credentials for harness/tools/sonar-review.sh — gitignored, never commit.
# Copy to harness/sonar.env and fill in. The environment wins over this file.
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=<user token — My Account → Security>
# Optional:
# SONAR_ORG=<organization key, SonarQube Cloud only>
# SONAR_SCANNER_BIN=/usr/local/bin/sonar-scanner
# SONAR_SCANNER_IMAGE=sonarsource/sonar-scanner-cli
# SONAR_CONTAINER=sonarqube          (container name for auto-discovery)
# SONAR_SCANNER_NETWORK=<docker network to run the scanner container on>
